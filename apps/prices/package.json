{
  "name": "@baromontres/prices",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "seed:build": "node scripts/import-references.ts",
    "db:migrate:local": "wrangler d1 migrations apply baromontres --local",
    "db:seed:local": "wrangler d1 execute baromontres --local --file=seed/references_seed.sql",
    "bookmarklet": "node scripts/build-bookmarklet.ts"
  },
  "dependencies": {
    "@baromontres/shared": "workspace:*",
    "hono": "^4.12.25"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241112.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6",
    "wrangler": "^3.95.0"
  }
}
